{
  "printWidth": 200,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    { "files": ["*.md"], "options": { "proseWrap": "preserve", "printWidth": 160 } },
    { "files": ["*.json", "*.jsonc"], "options": { "printWidth": 240 } },
    { "files": ["*.yml", "*.yaml"], "options": { "singleQuote": false } }
  ]
}
