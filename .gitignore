node_modules/
dist/
build/
venv/
env/
.env
# local env overrides and Worker secrets — only the *.example templates are tracked
.env.*
!.env.example
# Per-mode build config, generated from workers/wrangler.toml by scripts/build-web-env.mjs. Tracked on
# purpose: VITE_SUPABASE_URL and the anon key are public by Supabase's threat model (the whole bundle is
# readable, and RLS is the enforcement layer), and the alternative — telling an operator to export them
# inline — is how a Pages deploy ends up shipping an unconfigured app.
!.env.staging
!.env.production
# The mobile (Capacitor) build config — same public production values, tracked for the same reason.
!.env.mobile
workers/.dev.vars
.DS_Store
*.zip
*.tar.gz
*.log

# release pipeline outputs (see docs/RELEASE-PIPELINE.md)
release/
*.asar
.asar.unpacked/
.local/
.canvas/

# Generated by `npm run ci:install` from ci/workflows/ (the source of truth). Committed separately
# by a human with Actions:write — see docs/RELEASE-PIPELINE.md §0.
.github/workflows/

# Whole-tree dumps and the Replit-era leftovers. `repomix-output.xml` is deleted on purpose: it is a
# stale copy of every file in the repo (a source-of-truth imposter that also carried a personal
# address and a duplicated Supabase pair), and nothing reads it. Re-adding it needs a deliberate
# `git add -f`, which is the right friction for a file that re-commits half the tree.
repomix-output.xml
output.md
.replit
replit.md
replit.nix
# `wrangler dev` / `wrangler deploy` scratch space. It is a build cache with copies of the Worker's
# sources in it, and prettier/lint sweeps over a dev box's leftover bundles is not a signal about anything.
.wrangler/

# electron-builder's download cache (Electron binaries, fpm, 7zip, appimage). The CI workflow caches it
# at .cache/electron and .cache/electron-builder. It vendors third-party gem templates named `*.sh` that
# are Mustache, not bash, so it must never be committed or walked by our own shell-syntax checks.
.cache/

# ── Capacitor (Android/iOS native shells) ────────────────────────────────────
# The native projects (android/, ios/) ARE committed — they are the app shell CI builds. But three
# classes of generated content inside them are not, because `npx cap sync` recreates them from dist/web
# and node_modules on every build:
#   • the copied web bundle    — a second copy of dist/web, regenerated by `cap sync`
#   • Gradle / Xcode build output and caches
#   • CocoaPods' downloaded Pods and the developer's local signing
android/app/src/main/assets/public/
ios/App/App/public/
android/.gradle/
android/app/build/
android/build/
android/local.properties
android/app/release/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/res/xml/config.xml
ios/App/build/
ios/App/Pods/
ios/App/App/capacitor.config.json
ios/App/output/
ios/App/App/config.xml
# Capacitor writes a plugins manifest per platform; it is derived from node_modules at sync time.
android/app/capacitor.build.gradle
android/capacitor.settings.gradle
ios/App/App/capacitor.config.json
*.keystore
*.p12
