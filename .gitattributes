# Line endings are a packaging concern here: a dpkg maintainer script with CRLF does not run, and
# the deb is built from whatever bytes are in the tree.
* text=auto

*.sh    text eol=lf
*.bash  text eol=lf
packaging/hooks/** text eol=lf

*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.mjs   text eol=lf
*.cjs   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.desktop text eol=lf

# Release tooling output and vendored blobs are never reviewed line-by-line.
package-lock.json linguist-generated merge=binary
dist/**           linguist-generated
renderer/dist/**  linguist-generated
build/**          linguist-generated
release/**        linguist-generated
vendor/**         binary
*.woff2           binary
*.png             binary
*.jpg             binary
*.zip             binary

zipFile.zip filter=lfs diff=lfs merge=lfs -text
