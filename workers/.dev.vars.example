# Local development only. `wrangler dev` reads `workers/.dev.vars`; that file is git-ignored and
# must never be committed. Copy this file to `.dev.vars` and fill it in.
#
# Everything here points at STAGING. Do not paste production keys into a file on a laptop that
# `wrangler dev` will run with the service role key — that is the one credential in this project
# that can rewrite every match row, and a dev box is not where it belongs.

APP_ENV=development
SUPABASE_URL=https://REPLACE-WITH-STAGING-REF.supabase.co
SUPABASE_PROJECT_REF=REPLACE-WITH-STAGING-REF
SUPABASE_ANON_KEY=REPLACE-WITH-STAGING-PUBLISHABLE-KEY

# SECRET — Supabase dashboard → Settings → API → service_role (a.k.a. "secret key").
# Used only by supabaseAdmin(); grep `supabaseAdmin(` to see every place RLS is bypassed.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET — Settings → API → JWT Secret. Verifies the HS256 access token the SPA sends (middleware/auth.ts).
SUPABASE_JWT_SECRET=

# SECRET — Cloudflare Turnstile widget secret. Leave blank in dev: verifyTurnstile() skips the check.
TURNSTILE_SECRET_KEY=

# Exact origins allowed for CORS. `*` is rejected by src/env.ts on purpose; a `null` origin
# (sandboxed iframe, file://) is refused by the middleware, not implicitly allowed.
ALLOWED_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
